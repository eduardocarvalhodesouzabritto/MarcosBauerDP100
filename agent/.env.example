# Telegram — obtenha em @BotFather
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Anthropic Claude
ANTHROPIC_API_KEY=sua_chave_aqui

# Pipedrive (chave padrão — cada usuário pode registrar a sua via /minha_chave)
PIPEDRIVE_COMPANY_DOMAIN=nome_da_empresa

# IDs Telegram dos usuários autorizados (separados por vírgula)
# Para descobrir o ID: peça ao usuário para enviar /meu_id no bot
# Se deixado vazio, qualquer pessoa poderá usar o bot (não recomendado)
ALLOWED_USERS=123456789,987654321
