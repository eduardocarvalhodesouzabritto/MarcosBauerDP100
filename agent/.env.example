# Telegram — obtenha em @BotFather
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Anthropic Claude
ANTHROPIC_API_KEY=sua_chave_aqui

# Pipedrive — subdomínio da empresa (ex: minhaempresa.pipedrive.com → minhaempresa)
PIPEDRIVE_COMPANY_DOMAIN=nome_da_empresa

# Pipedrive — chave admin usada pela integração Read.ai automática
# (cada usuário do bot Telegram registra a sua via /minha_chave)
PIPEDRIVE_ADMIN_KEY=token_pipedrive_admin

# IDs Telegram autorizados (separados por vírgula) — use /meu_id para descobrir
ALLOWED_USERS=123456789,987654321

# Read.ai — integração automática de reuniões
READAI_API_KEY=sua_chave_readai
# ID Telegram que receberá notificações de sincronização (use /meu_id para descobrir)
NOTIFY_CHAT_ID=seu_id_telegram
# Intervalo de verificação em segundos (padrão: 300 = 5 minutos)
READAI_SYNC_INTERVAL=300
